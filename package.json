{
  "name": "agent-office",
  "version": "0.1.0",
  "description": "A cartoon 3D multiplayer office where your team spawns Claude Code workers at desks, shares live terminals, talks over voice, and tracks GitHub issues and PRs.",
  "type": "module",
  "bin": {
    "agent-office": "bin/agent-office.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "tsx watch src/server/cli.ts --port 4600 --password dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "build:whiteboard": "node scripts/build-whiteboard.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "start": "node bin/agent-office.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
